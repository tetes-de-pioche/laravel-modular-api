{
    "name": "tetes-de-pioche/laravel-modular-api",
    "description": "A Laravel package for creating JSON:API-compliant REST APIs, with support for versioning and multiple sub-APIs, organized into standalone, modular services.",
    "homepage": "https://github.com/tetes-de-pioche/laravel-modular-api",
    "keywords": [
        "laravel",
        "laravel-modular-api",
        "JSON-API",
        "api",
        "rest",
        "json"
    ],
    "license": "LicenseRef-DBAD",
    "authors": [
        {
            "name": "tetes-de-pioche",
            "email": "intendant@tetes-de-pioche.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "sqids/sqids": "^0.5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "TetesDePioche\\LaravelModularApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TetesDePioche\\LaravelModularApi\\LaravelModularApiServiceProvider"
            ],
            "aliases": {
                "LaravelModularApi": "TetesDePioche\\LaravelModularApi\\Facades\\LaravelModularApi"
            }
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
